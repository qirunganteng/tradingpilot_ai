# Salin file ini jadi "keystore.properties" (tanpa .example) di root project,
# isi dengan nilai asli kamu. File "keystore.properties" SUDAH masuk
# .gitignore — tidak akan pernah ter-commit ke git.
#
# Cara generate keystore baru (sekali saja, simpan baik-baik file .jks-nya —
# kalau hilang, kamu TIDAK BISA update app yang sudah dirilis ke Play Store
# dengan keystore lain):
#   keytool -genkeypair -v -keystore tradepilot-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias tradepilot

RELEASE_STORE_FILE=tradepilot-release.jks
RELEASE_STORE_PASSWORD=ganti-dengan-password-asli
RELEASE_KEY_ALIAS=tradepilot
RELEASE_KEY_PASSWORD=ganti-dengan-password-asli
