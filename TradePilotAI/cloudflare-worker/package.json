{
  "name": "tradepilot-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker AI Gateway untuk TradePilot AI — proxy Gemini + D1 (audit log) + R2 (arsip screenshot chart)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply tradepilot_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tradepilot_db --remote",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-manual.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.30",
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "3.99.0",
    "esbuild": "^0.24.0"
  }
}
